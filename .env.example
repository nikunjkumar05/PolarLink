# Copy to `.env` and edit before `docker compose up -d`.

# --- Required ---------------------------------------------------------------
# Signing key for JWT sessions. Generate one:
#   Windows PowerShell:
#     -join ((48..57)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#   Linux / macOS:
#     openssl rand -hex 32
POLARLINK_JWT_SECRET=

# --- Optional ---------------------------------------------------------------
# Host port nginx listens on.
POLARLINK_PORT=8080

# Session lifetime in seconds (default 12 hours).
POLARLINK_JWT_TTL=43200

# Extra browser origins allowed to call the API directly.
# The SPA is served same-origin by nginx, so this can stay empty.
# Comma-separated, e.g. https://app.example.com,http://localhost:5173
POLARLINK_CORS_ORIGINS=

# LLM drafting (FR-18). Leave POLARLINK_LLM_KEY empty to use the extractive
# composer, which works entirely offline.
POLARLINK_LLM_KEY=
POLARLINK_LLM_BASE_URL=https://api.openai.com/v1
POLARLINK_LLM_MODEL=gpt-4o-mini
